# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------

# Port the Express server listens on.
# Default: 3000
# PORT=3000

# ---------------------------------------------------------------------------
# Rate limiting  (applied to POST /api/leads/analyze only)
# ---------------------------------------------------------------------------

# Length of the sliding rate-limit window in milliseconds.
# Default: 60000 (1 minute)
# RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed per IP address per window.
# Default: 20  – suitable for local dev; tighten (e.g. 5) in production.
# RATE_LIMIT_MAX=20

# Number of trusted reverse-proxy hops used for client-IP resolution when
# rate limiting. Applied via app.set("trust proxy", <hops>) at startup.
#
# Default: 0 → proxy trust DISABLED. X-Forwarded-For is ignored and the
#            socket peer address is used. Keep this for direct deployments
#            (this project's current topology: the API is exposed directly,
#            with no reverse proxy in front of it).
#
# Set a positive integer ONLY when this service sits behind that exact number
# of known proxies and NOTHING else can reach it:
#   "1" → exactly one trusted hop (nginx, Cloudflare, AWS ALB, …)
#   "2" → two trusted hops (e.g. Cloudflare in front of nginx)
#
# Open-ended trust values ("true", "yes", …) are rejected at startup on
# purpose: Express's `trust proxy: true` accepts the whole X-Forwarded-For
# chain, letting any client spoof its IP and bypass the rate limit.
#
# ⚠️  WARNING: Do NOT set this above 0 unless ONLY your own proxy can reach
#              this service. Otherwise clients can spoof X-Forwarded-For and
#              bypass IP-based rate limiting.
# RATE_LIMIT_TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Minimum log level for the structured JSON logger (pino).
# Logs are emitted as single-line JSON objects to stdout.
# Accepted values (high → low verbosity): error | warn | info | debug
# Default: info
#   - error : only failures
#   - warn  : failures + warnings
#   - info  : + one completion line per request (method, route, status, duration)
#   - debug : + health-check completion lines and other diagnostics
# Invalid values abort startup so a typo is never silently ignored.
# The logger never records request bodies, raw lead messages, headers,
# authorization values, secrets, or full internal error details.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Ollama configuration
# ---------------------------------------------------------------------------

# Maximum time (in milliseconds) to wait for a single Ollama chat completion.
# Applies to every request, including the initial first-token latency.
# Default: 120000 (2 minutes) – suitable for a local 3B model running on CPU.
# Reduce this (e.g. 30000) if you run Ollama on a GPU and want faster failures.
# Increase it (e.g. 300000) for larger models or slower hardware.
# OLLAMA_TIMEOUT_MS=120000

# NOTE: The `ollama` library version currently used (0.6.x) hardcodes its host
# to http://127.0.0.1:11434 and does NOT read OLLAMA_HOST from the environment.
# Setting it here therefore has no effect today; it is documented only for
# forward compatibility if the client is later switched to a host-aware setup.
# To point the API at a different Ollama server you must change the client
# construction in src/services/lead-analyzer.ts.
# OLLAMA_HOST=http://127.0.0.1:11434

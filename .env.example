# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------

# Port the Express server listens on.
# Default: 3000
# PORT=3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Minimum log level for the structured JSON logger (pino).
# Logs are emitted as single-line JSON objects to stdout.
# Accepted values (high → low verbosity): error | warn | info | debug
# Default: info
#   - error : only failures
#   - warn  : failures + warnings
#   - info  : + one completion line per request (method, route, status, duration)
#   - debug : + health-check completion lines and other diagnostics
# Invalid values abort startup so a typo is never silently ignored.
# The logger never records request bodies, headers, authorization values,
# secrets, or full internal error details.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Lead analysis (the AI provider call) is no longer part of this backend: it
# runs inside the n8n workflow. Variables for AI providers (AI_PROVIDER,
# GEMINI_*, AI_TIMEOUT_MS), Ollama (OLLAMA_*, OLLAMA_TIMEOUT_MS), and rate
# limiting (RATE_LIMIT_*) are no longer read by this service and were removed.
# NODE_ENV is read only to print the environment label on startup.
